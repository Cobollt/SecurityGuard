<Window x:Class="SecurityGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SecurityGuard.UI.Converters"
        Title="SecurityGuard"
        Width="1280"
        Height="800"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <converters:IndexToVisibilityConverter
            x:Key="IndexToVisibilityConverter" />

        <Style x:Key="NavigationButton"
               TargetType="Button">

            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />

            <Setter Property="Margin"
                    Value="8,3" />

            <Setter Property="Padding"
                    Value="14,10" />

            <Setter Property="FontSize"
                    Value="14" />

        </Style>

        <Style x:Key="Card"
               TargetType="Border">

            <Setter Property="BorderBrush"
                    Value="#DDDDDD" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="6" />

            <Setter Property="Padding"
                    Value="14" />

            <Setter Property="Margin"
                    Value="4" />

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#20242A">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="SecurityGuard"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="18,20,18,20" />

                    <Button Style="{StaticResource NavigationButton}"
                            Content="Обзор"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="0" />

                    <Button Style="{StaticResource NavigationButton}"
                            Content="Контроль алгоритмов"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="1" />

                    <Button Style="{StaticResource NavigationButton}"
                            Content="Передача файлов"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="2" />

                    <Button Style="{StaticResource NavigationButton}"
                            Content="Проверка архивов"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="3" />

                    <Button Style="{StaticResource NavigationButton}"
                            Content="Карантин"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="4" />

                    <Button Style="{StaticResource NavigationButton}"
                            Content="Правила"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="5" />

                    <Button Style="{StaticResource NavigationButton}"
                            Content="Журнал"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="6" />

                    <Button Style="{StaticResource NavigationButton}"
                            Content="Настройки"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="7" />

                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="12">

                    <TextBlock Text="{Binding ServiceStatus}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="4" />

                    <Button Content="Обновить"
                            Command="{Binding RefreshCommand}" />

                </StackPanel>

            </DockPanel>

        </Border>

        <Grid Grid.Column="1"
              Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFF4D8"
                    BorderBrush="#E4B950"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasError,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                <TextBlock Text="{Binding LastError}"
                           TextWrapping="Wrap" />

            </Border>

            <Grid Grid.Row="1">

                <Grid Visibility="{Binding SelectedPageIndex,
                    Converter={StaticResource IndexToVisibilityConverter},
                    ConverterParameter=0}">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock Text="Обзор"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14" />

                            <TextBlock Text="Состояние модулей"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <ItemsControl ItemsSource="{Binding Modules}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Style="{StaticResource Card}"
                                                Width="240">

                                            <StackPanel>

                                                <TextBlock Text="{Binding Module}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Text="{Binding State}"
                                                           FontSize="14"
                                                           Margin="0,6,0,0" />

                                                <TextBlock Text="{Binding Message}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <TextBlock Text="Запросы безопасности"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,20,0,4" />

                            <ItemsControl ItemsSource="{Binding PendingRequests}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Style="{StaticResource Card}">

                                            <StackPanel>

                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontWeight="Bold" />

                                                <TextBlock Text="{Binding Module}"
                                                           Margin="0,4,0,0" />

                                                <TextBlock Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />

                                                <TextBlock Text="{Binding FilePath}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />

                                                <TextBlock Text="{Binding ProcessName}"
                                                           Margin="0,4,0,0" />

                                                <ItemsControl ItemsSource="{Binding Actions}"
                                                              Margin="0,8,0,0">

                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>

                                                        <DataTemplate>

                                                            <Button Content="{Binding DisplayName}"
                                                                    Command="{Binding Command}" />

                                                        </DataTemplate>

                                                    </ItemsControl.ItemTemplate>

                                                </ItemsControl>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <TextBlock Text="Последние события"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,20,0,4" />

                            <ListView ItemsSource="{Binding RecentEvents}"
                                      Height="260">

                                <ListView.View>

                                    <GridView>

                                        <GridViewColumn Header="Время"
                                                        Width="160"
                                                        DisplayMemberBinding="{Binding CreatedAtUtc}" />

                                        <GridViewColumn Header="Модуль"
                                                        Width="130"
                                                        DisplayMemberBinding="{Binding Module}" />

                                        <GridViewColumn Header="Событие"
                                                        Width="220"
                                                        DisplayMemberBinding="{Binding Title}" />

                                        <GridViewColumn Header="Действие"
                                                        Width="120"
                                                        DisplayMemberBinding="{Binding Action}" />

                                    </GridView>

                                </ListView.View>

                            </ListView>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

                <Grid Visibility="{Binding SelectedPageIndex,
                    Converter={StaticResource IndexToVisibilityConverter},
                    ConverterParameter=1}">

                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top">

                            <TextBlock Text="Контроль алгоритмов"
                                       FontSize="28"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Контроль запуска несанкционированных скриптов и алгоритмов."
                                       Margin="0,6,0,10" />

                        </StackPanel>

                        <ListView ItemsSource="{Binding AlgorithmEvents}">

                            <ListView.View>

                                <GridView>

                                    <GridViewColumn Header="Время"
                                                    Width="170"
                                                    DisplayMemberBinding="{Binding CreatedAtUtc}" />

                                    <GridViewColumn Header="Событие"
                                                    Width="240"
                                                    DisplayMemberBinding="{Binding Title}" />

                                    <GridViewColumn Header="Подробности"
                                                    Width="420"
                                                    DisplayMemberBinding="{Binding Details}" />

                                    <GridViewColumn Header="Действие"
                                                    Width="120"
                                                    DisplayMemberBinding="{Binding Action}" />

                                </GridView>

                            </ListView.View>

                        </ListView>

                    </DockPanel>

                </Grid>

                <Grid Visibility="{Binding SelectedPageIndex,
                    Converter={StaticResource IndexToVisibilityConverter},
                    ConverterParameter=2}">

                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top">

                            <TextBlock Text="Передача файлов"
                                       FontSize="28"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Контроль попыток передачи файлов с компьютера."
                                       Margin="0,6,0,10" />

                        </StackPanel>

                        <ListView ItemsSource="{Binding TransferEvents}">

                            <ListView.View>

                                <GridView>

                                    <GridViewColumn Header="Время"
                                                    Width="170"
                                                    DisplayMemberBinding="{Binding CreatedAtUtc}" />

                                    <GridViewColumn Header="Событие"
                                                    Width="240"
                                                    DisplayMemberBinding="{Binding Title}" />

                                    <GridViewColumn Header="Подробности"
                                                    Width="420"
                                                    DisplayMemberBinding="{Binding Details}" />

                                    <GridViewColumn Header="Действие"
                                                    Width="120"
                                                    DisplayMemberBinding="{Binding Action}" />

                                </GridView>

                            </ListView.View>

                        </ListView>

                    </DockPanel>

                </Grid>

                <Grid Visibility="{Binding SelectedPageIndex,
                    Converter={StaticResource IndexToVisibilityConverter},
                    ConverterParameter=3}">

                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top">

                            <TextBlock Text="Проверка архивов"
                                       FontSize="28"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Автоматическая и ручная проверка файлов и архивов."
                                       Margin="0,6,0,10" />

                        </StackPanel>

                        <ListView ItemsSource="{Binding ArchiveEvents}">

                            <ListView.View>

                                <GridView>

                                    <GridViewColumn Header="Время"
                                                    Width="170"
                                                    DisplayMemberBinding="{Binding CreatedAtUtc}" />

                                    <GridViewColumn Header="Событие"
                                                    Width="240"
                                                    DisplayMemberBinding="{Binding Title}" />

                                    <GridViewColumn Header="Подробности"
                                                    Width="420"
                                                    DisplayMemberBinding="{Binding Details}" />

                                    <GridViewColumn Header="Действие"
                                                    Width="120"
                                                    DisplayMemberBinding="{Binding Action}" />

                                </GridView>

                            </ListView.View>

                        </ListView>

                    </DockPanel>

                </Grid>

                <Grid Visibility="{Binding SelectedPageIndex,
                    Converter={StaticResource IndexToVisibilityConverter},
                    ConverterParameter=4}">

                    <StackPanel>

                        <TextBlock Text="Карантин"
                                   FontSize="28"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Объектов в карантине:"
                                   FontSize="16"
                                   Margin="0,20,0,4" />

                        <TextBlock Text="{Binding QuarantineCount}"
                                   FontSize="42"
                                   FontWeight="Bold" />

                        <TextBlock Text="Просмотр, восстановление и окончательное удаление объектов будет подключено к общей службе на следующем этапе интерфейса."
                                   TextWrapping="Wrap"
                                   Margin="0,20,0,0" />

                    </StackPanel>

                </Grid>

                <Grid Visibility="{Binding SelectedPageIndex,
                    Converter={StaticResource IndexToVisibilityConverter},
                    ConverterParameter=5}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Правила и исключения"
                                    FontSize="28"
                                    FontWeight="SemiBold" />

                            <TextBlock Text="Общие правила безопасности SecurityGuard"
                                    Margin="0,6,0,14" />

                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">

                            <Border Style="{StaticResource Card}"
                                    Width="180">

                                <StackPanel>

                                    <TextBlock Text="Всего правил"
                                            FontWeight="SemiBold" />

                                    <TextBlock Text="{Binding Rules.Count}"
                                            FontSize="28"
                                            FontWeight="Bold"
                                            Margin="0,6,0,0" />

                                </StackPanel>

                            </Border>

                            <Border Style="{StaticResource Card}"
                                    Width="180">

                                <StackPanel>

                                    <TextBlock Text="Разрешающих"
                                            FontWeight="SemiBold" />

                                    <TextBlock Text="{Binding AllowRules.Count}"
                                            FontSize="28"
                                            FontWeight="Bold"
                                            Margin="0,6,0,0" />

                                </StackPanel>

                            </Border>

                            <Border Style="{StaticResource Card}"
                                    Width="180">

                                <StackPanel>

                                    <TextBlock Text="Блокирующих"
                                            FontWeight="SemiBold" />

                                    <TextBlock Text="{Binding BlockRules.Count}"
                                            FontSize="28"
                                            FontWeight="Bold"
                                            Margin="0,6,0,0" />

                                </StackPanel>

                            </Border>

                        </StackPanel>

                        <TabControl Grid.Row="2">

                            <TabItem Header="Все">

                                <ListView ItemsSource="{Binding Rules}">

                                    <ListView.View>

                                        <GridView>

                                            <GridViewColumn Header="Имя"
                                                            Width="180"
                                                            DisplayMemberBinding="{Binding Name}" />

                                            <GridViewColumn Header="Модуль"
                                                            Width="160"
                                                            DisplayMemberBinding="{Binding ModuleDisplayName}" />

                                            <GridViewColumn Header="Решение"
                                                            Width="120"
                                                            DisplayMemberBinding="{Binding DecisionDisplayName}" />

                                            <GridViewColumn Header="Тип"
                                                            Width="150"
                                                            DisplayMemberBinding="{Binding ScopeDisplayName}" />

                                            <GridViewColumn Header="Значение"
                                                            Width="360"
                                                            DisplayMemberBinding="{Binding Value}" />

                                            <GridViewColumn Header="Дополнительные условия"
                                                            Width="430"
                                                            DisplayMemberBinding="{Binding ConditionsDisplayName}" />

                                            <GridViewColumn Header="Приоритет"
                                                            Width="90"
                                                            DisplayMemberBinding="{Binding Priority}" />

                                            <GridViewColumn Header="Состояние"
                                                            Width="100"
                                                            DisplayMemberBinding="{Binding EnabledDisplayName}" />

                                            <GridViewColumn Header="">

                                                <GridViewColumn.CellTemplate>

                                                    <DataTemplate>

                                                        <Button Content="Удалить"
                                                                Command="{Binding DeleteCommand}"
                                                                Padding="8,4"
                                                                Margin="2" />

                                                    </DataTemplate>

                                                </GridViewColumn.CellTemplate>

                                            </GridViewColumn>

                                        </GridView>

                                    </ListView.View>

                                </ListView>

                            </TabItem>

                            <TabItem Header="Разрешения">

                                <ListView ItemsSource="{Binding AllowRules}">

                                    <ListView.View>

                                        <GridView>

                                            <GridViewColumn Header="Имя"
                                                            Width="200"
                                                            DisplayMemberBinding="{Binding Name}" />

                                            <GridViewColumn Header="Модуль"
                                                            Width="170"
                                                            DisplayMemberBinding="{Binding ModuleDisplayName}" />

                                            <GridViewColumn Header="Тип"
                                                            Width="160"
                                                            DisplayMemberBinding="{Binding ScopeDisplayName}" />

                                            <GridViewColumn Header="Значение"
                                                            Width="420"
                                                            DisplayMemberBinding="{Binding Value}" />

                                            <GridViewColumn Header="">

                                                <GridViewColumn.CellTemplate>

                                                    <DataTemplate>

                                                        <Button Content="Удалить"
                                                                Command="{Binding DeleteCommand}"
                                                                Padding="8,4"
                                                                Margin="2" />

                                                    </DataTemplate>

                                                </GridViewColumn.CellTemplate>

                                            </GridViewColumn>

                                        </GridView>

                                    </ListView.View>

                                </ListView>

                            </TabItem>

                            <TabItem Header="Блокировки">

                                <ListView ItemsSource="{Binding BlockRules}">

                                    <ListView.View>

                                        <GridView>

                                            <GridViewColumn Header="Имя"
                                                            Width="200"
                                                            DisplayMemberBinding="{Binding Name}" />

                                            <GridViewColumn Header="Модуль"
                                                            Width="170"
                                                            DisplayMemberBinding="{Binding ModuleDisplayName}" />

                                            <GridViewColumn Header="Тип"
                                                            Width="160"
                                                            DisplayMemberBinding="{Binding ScopeDisplayName}" />

                                            <GridViewColumn Header="Значение"
                                                            Width="420"
                                                            DisplayMemberBinding="{Binding Value}" />

                                            <GridViewColumn Header="">

                                                <GridViewColumn.CellTemplate>

                                                    <DataTemplate>

                                                        <Button Content="Удалить"
                                                                Command="{Binding DeleteCommand}"
                                                                Padding="8,4"
                                                                Margin="2" />

                                                    </DataTemplate>

                                                </GridViewColumn.CellTemplate>

                                            </GridViewColumn>

                                        </GridView>

                                    </ListView.View>

                                </ListView>

                            </TabItem>

                        </TabControl>

                    </Grid>

                </Grid>
                    Converter={StaticResource IndexToVisibilityConverter},
                    ConverterParameter=5}">

                    <StackPanel>

                        <TextBlock Text="Правила и исключения"
                                   FontSize="28"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Здесь будут находиться общие правила для всех трёх модулей."
                                   Margin="0,10,0,0" />

                        <TextBlock Text="Контроль алгоритмов: SHA-256, путь, издатель, интерпретатор и родительский процесс."
                                   Margin="0,18,0,0"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Передача файлов: файл, приложение, назначение, порт и протокол."
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Проверка архивов: доверенные файлы, хэши, пути и исключения сканирования."
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />

                    </StackPanel>

                </Grid>

                <Grid Visibility="{Binding SelectedPageIndex,
                    Converter={StaticResource IndexToVisibilityConverter},
                    ConverterParameter=6}">

                    <DockPanel>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="Журнал событий"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <ListView ItemsSource="{Binding RecentEvents}">

                            <ListView.View>

                                <GridView>

                                    <GridViewColumn Header="Время"
                                                    Width="170"
                                                    DisplayMemberBinding="{Binding CreatedAtUtc}" />

                                    <GridViewColumn Header="Модуль"
                                                    Width="140"
                                                    DisplayMemberBinding="{Binding Module}" />

                                    <GridViewColumn Header="Тип"
                                                    Width="160"
                                                    DisplayMemberBinding="{Binding Type}" />

                                    <GridViewColumn Header="Уровень"
                                                    Width="100"
                                                    DisplayMemberBinding="{Binding Severity}" />

                                    <GridViewColumn Header="Событие"
                                                    Width="220"
                                                    DisplayMemberBinding="{Binding Title}" />

                                    <GridViewColumn Header="Действие"
                                                    Width="120"
                                                    DisplayMemberBinding="{Binding Action}" />

                                </GridView>

                            </ListView.View>

                        </ListView>

                    </DockPanel>

                </Grid>

                <Grid Visibility="{Binding SelectedPageIndex,
                    Converter={StaticResource IndexToVisibilityConverter},
                    ConverterParameter=7}">

                    <StackPanel>

                        <TextBlock Text="Настройки"
                                FontSize="28"
                                FontWeight="SemiBold" />

                        <TextBlock Text="AlgorithmGuard"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Margin="0,24,0,12" />

                        <CheckBox Content="Включить контроль алгоритмов"
                                IsChecked="{Binding AlgorithmGuardEnabled}"
                                FontSize="15"
                                Margin="0,4,0,12" />

                        <TextBlock Text="Режим"
                                FontWeight="SemiBold"
                                Margin="0,8,0,4" />

                        <ComboBox ItemsSource="{Binding AlgorithmGuardModes}"
                                SelectedItem="{Binding AlgorithmGuardMode}"
                                Width="220"
                                HorizontalAlignment="Left" />

                        <TextBlock Text="Поведение при ошибке системной блокировки"
                                FontWeight="SemiBold"
                                Margin="0,18,0,4" />

                        <ComboBox ItemsSource="{Binding AlgorithmGuardFailurePolicies}"
                                SelectedItem="{Binding AlgorithmGuardFailurePolicy}"
                                Width="220"
                                HorizontalAlignment="Left" />

                        <TextBlock Text="Monitor — только наблюдение и внутренние правила. Enforce — применение поддерживаемых Block-правил через Windows."
                                TextWrapping="Wrap"
                                MaxWidth="650"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0" />

                        <TextBlock Text="FailOpen — при ошибке enforcement мониторинг продолжается. FailClosed — AlgorithmGuard переходит в Faulted."
                                TextWrapping="Wrap"
                                MaxWidth="650"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0" />

                        <Button Content="Сохранить настройки"
                                Width="200"
                                HorizontalAlignment="Left"
                                Margin="0,20,0,0"
                                Command="{Binding SaveAlgorithmGuardSettingsCommand}" />

                        <Separator Margin="0,28,0,20" />

                        <TextBlock Text="Состояние службы"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,4,0,4" />

                        <TextBlock Text="{Binding ServiceStatus}" />

                        <TextBlock Text="Объекты карантина"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,20,0,4" />

                        <TextBlock Text="{Binding QuarantineCount}" />

                        <TextBlock Text="Последнее обновление"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,20,0,4" />

                        <TextBlock Text="{Binding LastRefreshUtc}" />

                        <Button Content="Обновить состояние"
                                Width="180"
                                HorizontalAlignment="Left"
                                Margin="0,24,0,0"
                                Command="{Binding RefreshCommand}" />

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>